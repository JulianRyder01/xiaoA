<navigation-bar title="登录/注册" back="{{false}}" color="black" background="#165dff"></navigation-bar>
<view class="login-container" style="height: 966rpx; display: block; box-sizing: border-box; left: 0rpx; top: 0rpx">

  <!-- 登录/注册卡片 -->
  <view class="login-card">
  <view class="avatar" style="position: relative; left: 282rpx; top: 85rpx; width: 129rpx; height: 129rpx; display: block; box-sizing: border-box"><img src="" alt=""/></view>
    <!-- 第一部分 -->
    <view class="section">

      


      <!-- 表单区域 -->
      <view class="form-section" style="position: relative; left: 0rpx; top: 164rpx">
        <view class="form-item">
          <view class="form-label">
            <text class="label-text">姓名</text>
            <text class="label-required">*</text>
          </view>
          <input 
            class="form-input" 
            placeholder="请输入真实姓名" 
            placeholder-class="placeholder"
            type="text"
            value="{{name}}"
            bindinput="onNameInput"
          />
        </view>

        <view class="form-item">
          <view class="form-label">
            <text class="label-text">手机号</text>
            <text class="label-required">*</text>
          </view>
          <input 
            class="form-input" 
            placeholder="请输入手机号" 
            placeholder-class="placeholder"
            type="number"
            value="{{phone}}"
            bindinput="onPhoneInput"
            maxlength="11"
          />
        </view>
      </view>
    </view>



  </view>
  <button style="height: 83rpx; display: block; box-sizing: border-box; left: 0rpx; top: 272rpx; position: relative">
  登录/注册
  </button>

  <!-- 底部版权信息 -->


  <!-- 加载中弹窗 -->
  <view class="loading-modal" wx:if="{{loading}}">
    <view class="loading-content">
      <image class="loading-icon" src="/images/loading.gif"></image>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>
</view>
<custom-tabbar currentPage="home"></custom-tabbar>