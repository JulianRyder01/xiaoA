<!-- 顶部导航栏 -->
<navigation-bar title="团队介绍" back="{{false}}" color="#fff" background="blue"></navigation-bar>
<!-- 轮播图区域 -->
<swiper class="banner-swiper" indicator-dots circular>
  <swiper-item >
    <view class="banner-item">
      <!-- 轮播图占位，实际替换为图片路径 -->
      <image src="/images/team-banner1.png" mode="widthFix"></image>
    </view>
  </swiper-item>
  <swiper-item>
    <view class="banner-item">
      <image src="/images/team-banner2.png" mode="widthFix"></image>
    </view>
  </swiper-item>
</swiper>

<!-- 选项卡区域 -->
<view class="tab-group">
  <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0">
    <image src="/images/team-icon.png" mode="widthFix"></image>
    <text>团队风采</text>
  </view>
  <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1">
    <image src="/images/group-icon.png" mode="widthFix"></image>
    <text>组别介绍</text>
  </view>
</view>

<!-- 内容区域 -->
<view class="content-area">
  <view class="content-title">团队介绍</view>
  <view class="content-input">
    <textarea placeholder="请输入" bindinput="onInput"></textarea>
  </view>
</view>

<!-- 底部图片区域 -->
<view class="bottom-img" style="width: 616rpx; display: flex; box-sizing: border-box; position: relative; left: 46rpx; top: 27rpx; height: 274rpx">
  <!-- 底部图片占位，实际替换为图片路径 -->
  <image src="/images/team-bottom.png" mode="widthFix"></image>
</view>

<custom-tabbar currentPage="home"></custom-tabbar>