<navigation-bar title="报名详情" back="{{false}}" color="#fff" background="#165dff"></navigation-bar><view class="container">
  <form bindsubmit="formSubmit">
    
    <!-- 姓名 -->
    <view class="form-item">
      <text class="label">*姓名</text>
      <input 
        class="input" 
        name="name" 
        placeholder="请输入姓名" 
        placeholder-class="placeholder"
        maxlength="10"
      />
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="label">*性别</text>
      <radio-group name="gender">
        <label class="radio-label">
          <radio value="女" checked/> 女
        </label>
        <label class="radio-label">
          <radio value="男"/> 男
        </label>
      </radio-group>
    </view>

    <!-- 联系方式 -->
    <view class="form-item">
      <text class="label">*联系方式</text>
      <input 
        class="input" 
        name="contact" 
        placeholder="请输入联系方式" 
        placeholder-class="placeholder"
        type="number"
        maxlength="11"
      />
    </view>

    <!-- 学号 -->
    <view class="form-item">
      <text class="label">*学号</text>
      <input 
        class="input" 
        name="studentId" 
        placeholder="请输入学号" 
        placeholder-class="placeholder"
        maxlength="12"
      />
    </view>

    <!-- 学院 -->
    <view class="form-item">
      <text class="label">*学院</text>
      <picker 
        class="picker" 
        name="college" 
        range="{{collegeList}}" 
        value="{{collegeIndex}}" 
        bindchange="bindCollegeChange"
      >
        <view class="picker-text">{{collegeList[collegeIndex]}}</view>
      </picker>
    </view>

    <!-- 年级 -->
    <view class="form-item">
      <text class="label">*年级</text>
      <picker 
        class="picker" 
        name="grade" 
        range="{{gradeList}}" 
        value="{{gradeIndex}}" 
        bindchange="bindGradeChange"
      >
        <view class="picker-text">{{gradeList[gradeIndex]}}</view>
      </picker>
    </view>

    <!-- 专业班级 -->
    <view class="form-item">
      <text class="label">*专业班级</text>
      <input 
        class="input" 
        name="majorClass" 
        placeholder="请输入专业班级，例X专业X班" 
        placeholder-class="placeholder"
        maxlength="30"
      />
    </view>

    <!-- 选择组别 -->
    <view class="form-item">
      <text class="label">*选择组别</text>
      <picker 
        class="picker" 
        name="group" 
        range="{{groupList}}" 
        value="{{groupIndex}}" 
        bindchange="bindGroupChange"
      >
        <view class="picker-text">{{groupList[groupIndex]}}</view>
      </picker>
    </view>

    <!-- 个人简介 -->
    <view class="form-item textarea-item">
      <text class="label">*个人简介</text>
      <textarea 
        class="textarea" 
        name="introduction" 
        placeholder="请输入个人简介（500字内）" 
        placeholder-class="placeholder"
        maxlength="500"
        bindinput="countWords"
      />
      <text class="word-count">{{wordCount}}/500</text>
    </view>

    <!-- 提交按钮 -->
    <button class="submit-btn" form-type="submit" type="primary">提交</button>

  </form>
</view>